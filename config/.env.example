# 复制为 config/.env 后填写（该文件已被 .gitignore 忽略）
# 桌面版 exe 会自己在设置窗口里生成这个文件，一般不用手改

# 必填：学号
CUPL_USERNAME=你的学号

# 必填：智慧法大统一认证密码（不是教务本地密码）
CUPL_PASSWORD=在这里填密码

# 认证方式：tpass（统一认证，推荐） / local（教务本地账号，通常不可用）
AUTH_MODE=tpass

# 通知渠道：desktop（电脑通知，默认） / none（静默） / dingtalk / feishu
NOTIFY_CHANNEL=desktop

# 强提醒：1 = 新增成绩时弹置顶窗口 + 闪烁任务栏 + 提示音；0 = 只弹系统通知
NOTIFY_STRONG=1

# 仅当 NOTIFY_CHANNEL 为 dingtalk / feishu 时才需要下面两项
# NOTIFY_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=在这里填
# NOTIFY_SECRET=

# 以下为可选
# CHECK_INTERVAL_MIN=10
# STATE_PATH=state/grades.json
# CUPL_GRADE_URL=
# HTTP_TIMEOUT=25
# DRY_RUN=0
