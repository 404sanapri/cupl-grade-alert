# 复制为 config/.env 后填写（该文件已被 .gitignore 忽略）
# GitHub Actions 上不使用本文件，而是用仓库 Secrets

# 必填：学号
CUPL_USERNAME=你的学号

# 必填：智慧法大统一认证密码（不是教务本地密码）
CUPL_PASSWORD=在这里填密码

# 认证方式：tpass（统一认证，推荐） / local（教务本地账号，通常不可用）
AUTH_MODE=tpass

# 通知渠道：dingtalk / feishu / none
NOTIFY_CHANNEL=dingtalk

# 机器人 Webhook
NOTIFY_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=在这里填

# 加签密钥（SEC 开头）；用「自定义关键词」校验时留空
NOTIFY_SECRET=

# 以下为可选
# STATE_PATH=state/grades.json
# CUPL_GRADE_URL=
# HTTP_TIMEOUT=25
# DRY_RUN=0
